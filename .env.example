# Gigly Environment Variables Configuration
APP_NAME=Gigly
APP_ENV=development
SECRET_KEY=gigly-super-secret-key-change-me-in-production-2026-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database: SQLite in local, PostgreSQL in Render (DATABASE_URL provided automatically by Render)
DATABASE_URL=sqlite:///./gigly.db

# Platform Commission Rates (%)
PLATFORM_SELLER_FEE_PERCENT=10.0
PLATFORM_BUYER_FEE_PERCENT=3.0

# Base URL
BASE_URL=http://localhost:8000
